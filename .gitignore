# ---- secrets: commit this file BEFORE anything else ----
.env
.env.*
!.env.example
*.key
credentials.json
service-account*.json

# ---- fetched raw data (large, regenerable, NOT the deliverable) ----
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose
# parent directory is excluded, and the 5 seed games below must stay committed
# so the eval harness is reproducible.
# (git takes no inline comments in patterns - keep the appids bare)
# 553850 HELLDIVERS 2 / 1091500 Cyberpunk 2077 / 233860 Kenshi
# 413150 Stardew Valley / 1190460 DEATH STRANDING
data/raw/*
!data/raw/553850.json
!data/raw/1091500.json
!data/raw/233860.json
!data/raw/413150.json
!data/raw/1190460.json
data/cache/
*.jsonl

# ---- filtered corpus (input to extraction) ----
# Same rule: seed survivors are committed so the evals reproduce. The dropped
# dumps are NOT - they are regenerable, and there is no reason to put slurs and
# censored rants into git history permanently.
data/filtered/*
!data/filtered/553850.json
!data/filtered/1091500.json
!data/filtered/233860.json
!data/filtered/413150.json
!data/filtered/1190460.json
data/filtered/*.dropped.txt

# NOTE: public/verdicts/ is intentionally NOT ignored.
# Those generated verdict JSONs are what the static site serves.
# If they get ignored, the deployed site will be empty.

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---- node / next.js ----
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.eslintcache

# ---- deploy ----
.vercel/
.netlify/

# ---- claude code ----
.claude/settings.local.json

# ---- logs & scratch ----
*.log
npm-debug.log*
yarn-error.log*
scratch/
tmp/
notes-private.md

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
