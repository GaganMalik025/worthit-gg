# ---- secrets: commit this file BEFORE anything else ----
.env
.env.*
!.env.example
*.key
credentials.json
service-account*.json

# ---- fetched raw data (large, regenerable, NOT the deliverable) ----
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose
# parent directory is excluded, and the 5 seed games below must stay committed
# so the eval harness is reproducible.
data/raw/*
!data/raw/553850.json    # HELLDIVERS 2
!data/raw/1091500.json   # Cyberpunk 2077
!data/raw/233860.json    # Kenshi
!data/raw/413150.json    # Stardew Valley
!data/raw/1190460.json   # DEATH STRANDING
data/cache/
*.jsonl

# NOTE: public/verdicts/ is intentionally NOT ignored.
# Those generated verdict JSONs are what the static site serves.
# If they get ignored, the deployed site will be empty.

